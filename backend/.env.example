PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/trustbox
MONGO_URI=mongodb://127.0.0.1:27017/trustbox

# EMQX Cloud MQTT broker (TLS on port 8883)
MQTT_URL=mqtts://YOUR-ID.emqxsl.com:8883
MQTT_USER=your_emqx_username
MQTT_PASS=your_emqx_password
MQTT_CA_PATH=
IOT_MQTT_TOPIC="trustbox/raw/#"

DEVICE_KEY=trustbox-super-secret-key-32ch
CLAIM_TEMP_C=8.0
CLAIM_WINDOW_SEC=15
